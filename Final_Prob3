import numpy as np
import matplotlib.pyplot as plt

# Parameters
delta = 1.5
h = 0.01
xi = np.arange(0, 1 + h, h)
n = len(xi)

# Right-hand side function f(xi)
def f(xi_val):
    numerator = -(1 - xi_val)
    denominator = (1 + (delta - 1) * xi_val)**4
    return numerator / denominator

# matrices
A = np.zeros((n, n))
b = np.zeros(n)

# conditions
A[0, 0] = 1
b[0] = 0
A[n-1, n-1] = 1
b[n-1] = 0

for i in range(1, n-1):
    A[i, i-1] = 1 / h**2
    A[i, i] = -2 / h**2
    A[i, i+1] = 1 / h**2
    b[i] = f(xi[i])

y = np.linalg.solve(A, b)

# plot
plt.figure(figsize=(10, 6))
plt.plot(xi, y, 'b-', label='Beam Displacement (y)')
plt.xlabel(r'Nondimensional length')
plt.ylabel('Nondimensional displacement')
plt.title('Problem 3')
plt.grid(True)
plt.legend()
plt.show()
